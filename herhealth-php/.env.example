# HerHealth Liberia (PHP) — copy to .env and fill in. Never commit .env.
APP_ENV=development            # development | testing | pilot | production (tags every analytics event)
APP_DEBUG=0
APP_SECRET=                    # 64 random hex characters: php -r "echo bin2hex(random_bytes(32));"
APP_BASE_PATH=                 # e.g. /herhealth if served from a sub-folder

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=herhealth
DB_USER=herhealth              # restricted user: SELECT/INSERT/UPDATE/DELETE on herhealth.* only in production
DB_PASS=

# First admin account created by database/seed.php (must be changed at first sign-in)
ADMIN_EMAIL=admin@herhealth.local
ADMIN_INITIAL_PASSWORD=

# Provider-independent AI layer: none | anthropic | openai (any OpenAI-compatible endpoint)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=20

# Trusted-sites web answers (only when the reviewed library has no answer). Uses the Anthropic web-search tool.
# Falls back to AI_API_KEY when AI_PROVIDER=anthropic. Admin can switch it off: Settings -> web_search_enabled.
WEB_SEARCH_API_KEY=
WEB_SEARCH_MODEL=claude-opus-5-5
WEB_SEARCH_TIMEOUT=45
