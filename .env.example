# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string for production (must have the pgvector extension available).
# Leave empty for local development: an embedded PostgreSQL (PGlite) is stored in ./data/pglite.
DATABASE_URL=

# Secret used to hash anonymous question text and session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# AI provider: "anthropic" or "none".
# With "none", the assistant answers with the exact text of the best-matching approved article passage.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Which environment this deployment's public traffic is recorded as:
#   development | testing | pilot | production
# Browsers signed in to the admin are always recorded as development, and devices put into
# participant mode (Admin → Testing) as testing. Defaults: development (dev server), production (build).
ANALYTICS_ENVIRONMENT=development
# Environments counted on the public /impact page (comma-separated). Development is never shown by default.
PUBLIC_IMPACT_ENVIRONMENTS=testing,pilot,production

# Where Quick Exit sends the user (a neutral page).
NEXT_PUBLIC_QUICK_EXIT_URL=https://www.google.com/

# Public base URL (used for absolute links)
PUBLIC_BASE_URL=http://localhost:3000
